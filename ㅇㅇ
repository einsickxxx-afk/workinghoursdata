  // ---- 점: 크기 = 그룹 인원 수 — 부서 모드는 팀명 항상 표시, 개인 모드는 클릭해야 명단 확인 ----
  const nMax = Math.max(...groups.map(g=>g.n));
  groups.forEach((g,idx)=>{ g.id = 'g'+idx; });

  // 각 그룹의 점 좌표(cx, cy)와 반지름 먼저 계산
  groups.forEach(g => {
    g.cx = sx(g.x);
    g.cy = sy(g.y);
    g.r = mode==='dept' ? (7 + Math.sqrt(g.n/Math.max(1,nMax))*7) : (7 + Math.sqrt(g.n/Math.max(1,nMax))*11);
    g.labelY = g.cy; // 기본값: 점과 같은 높이. 겹치면 아래에서 밀어냄
  });

  // ---- 라벨 겹침 방지 (부서 모드): y좌표 기준 정렬 후 최소 간격 이하로 가까우면 아래로 밀어냄 ----
  if(mode === 'dept'){
    const LABEL_GAP = 15; // 라벨 한 줄의 최소 세로 간격(px)
    const sorted = [...groups].sort((a,b) => a.cy - b.cy);
    for(let i = 1; i < sorted.length; i++){
      const prev = sorted[i-1], cur = sorted[i];
      if(cur.labelY - prev.labelY < LABEL_GAP){
        cur.labelY = prev.labelY + LABEL_GAP;
      }
    }
    // 맨 아래 라벨이 차트 밖으로 밀려났으면 전체를 위로 당겨 안쪽에 맞춤
    const bottomLimit = H - B - 6;
    const overflow = sorted[sorted.length-1].labelY - bottomLimit;
    if(overflow > 0){
      sorted.forEach(g => { g.labelY -= overflow; });
    }
  }

  const pointEls = groups.map(g => {
    const cx = g.cx, cy = g.cy, r = g.r;
    const color = colorForHour(g.x);
    const title = mode==='dept'
      ? `${g.teamName}: 평균 ${fmt1(g.x)}시간 (평균 대비 ${g.y>=0?'+':''}${fmt1(g.y)}시간) · ${g.n}명`
      : `${fmt1(g.x)}시간 근무 ${g.n}명 (평균 대비 ${g.y>=0?'+':''}${fmt1(g.y)}시간)`;
    const labelAnchor = cx > W - 120 ? 'end' : 'start';
    const labelDx = cx > W - 120 ? -(r+6) : (r+6);
    const labelMoved = mode==='dept' && Math.abs(g.labelY - cy) > 1;
    // 라벨이 밀려난 경우, 점과 라벨을 잇는 가는 연결선을 그어 어느 점인지 알 수 있게 함
    const leaderLine = labelMoved
      ? `<line x1="${cx+(labelDx>0?r:-r)}" y1="${cy}" x2="${cx+labelDx-(labelDx>0?4:-4)}" y2="${g.labelY}" stroke="var(--muted)" stroke-width="0.8" stroke-opacity="0.6"/>`
      : '';
    const teamLabel = mode==='dept'
      ? `<text x="${cx+labelDx}" y="${g.labelY+3.5}" font-size="10.5" font-weight="700" fill="var(--navy)" text-anchor="${labelAnchor}" pointer-events="none">${g.teamName}</text>`
      : '';
    return `<g class="quad-point" data-group="${g.id}">
      ${leaderLine}
      <circle cx="${cx}" cy="${cy}" r="${r}" fill="${color}" fill-opacity="0.85" stroke="rgba(13,39,68,0.3)" stroke-width="1.2"/>
      ${mode==='person' && g.n>1 ? `<text x="${cx}" y="${cy+4}" font-size="11" font-weight="800" fill="var(--navy)" text-anchor="middle" pointer-events="none">${g.n}</text>` : ''}
      ${teamLabel}
      <title>${title}</title>
    </g>`;
  }).join('');

  svg.innerHTML = `
    ${xTickEls}${yTickEls}
    <rect x="${L}" y="${T}" width="${W-L-R}" height="${H-T-B}" fill="none" stroke="var(--border)" stroke-width="1"/>
